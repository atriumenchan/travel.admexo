# Travelpayouts API credentials (used for cached fallback prices, airport
# autocomplete data, and affiliate deep links)
# Get yours at https://www.travelpayouts.com/developers/api
TRAVELPAYOUTS_TOKEN=your_api_token_here
TRAVELPAYOUTS_MARKER=your_affiliate_marker_here

# ---------------------------------------------------------------------------
# Live flight-search providers (aggregated in lib/aggregator.ts)
#
# Each provider accepts one OR SEVERAL comma-separated keys, e.g.
#   RAPIDAPI_KEY_PRICELINE=key_one,key_two,key_three
# When multiple keys are given, requests are round-robined across them and
# any key that gets rate-limited is automatically skipped in favor of the
# others — this pools quota across multiple subscriptions instead of being
# capped by a single key's limit.
#
# A provider is only queried if it has at least one key configured, so you
# can enable/disable providers just by adding/removing env vars. To add a
# brand new provider, implement the FlightProvider interface in
# lib/providers/<name>.ts and register it in lib/aggregator.ts.
# ---------------------------------------------------------------------------

# Priceline (RapidAPI) — https://rapidapi.com (subscribe to "Priceline Com Provider")
RAPIDAPI_KEY_PRICELINE=your_rapidapi_key_here
# Legacy alias, still read as a fallback if RAPIDAPI_KEY_PRICELINE is unset
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Flights via SerpApi — https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here
